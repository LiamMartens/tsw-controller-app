{
  "type": "object",
  "title": "Step Threshold Definition",
  "description": "Defines the threshold of a step which can be used to remap a direct/api control like value",
  "properties": {
    "threshold": {
      "oneOf": [
        {
          "type": "number",
          "description": "Defines the actual threshold value"
        },
        {
          "type": "object",
          "required": ["reference", "value"],
          "properties": {
            "reference": { "type": "string" },
            "value": { "type": "number" }
          }
        }
      ]
    },
    "threshold_end": {
      "oneOf": [
        {
          "type": "number",
          "description": "Defines the threshold end value for ranges"
        },
                {
          "type": "object",
          "required": ["reference", "value"],
          "properties": {
            "reference": { "type": "string" },
            "value": { "type": "number" }
          }
        }
      ]
    },
    "threshold_tolerance": {
      "type": "number",
      "description": "Defines the tolerance for the threshold"
    }
  },
  "required": ["threshold"]
}
